{
  "name": "cc-cache-alert",
  "version": "1.0.0",
  "description": "Telegram alerts and terminal statusline indicator before your Claude Code CLI prompt cache expires (1h & 5m TTL).",
  "main": "dist/index.js",
  "bin": {
    "cc-cache-alert": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "prompt-caching",
    "telegram",
    "notification",
    "alert",
    "anthropic",
    "ai"
  ],
  "author": "candiesdoodle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/candiesdoodle/cc-cache-alert.git"
  },
  "bugs": {
    "url": "https://github.com/candiesdoodle/cc-cache-alert/issues"
  },
  "homepage": "https://github.com/candiesdoodle/cc-cache-alert#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
